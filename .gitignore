# -------------------------------
# Project private resume data
# -------------------------------

# Original resumes contain personal data
data/real_resumes/original/*
!data/real_resumes/original/.gitkeep

# Extracted resume text contains personal data
data/real_resumes/extracted_text/*
!data/real_resumes/extracted_text/.gitkeep

# Metadata may contain file paths and candidate-related info
data/real_resumes/metadata/*
!data/real_resumes/metadata/.gitkeep

# Generated outputs may contain candidate data
output/extraction/*
!output/extraction/.gitkeep

output/section_discovery/*
!output/section_discovery/.gitkeep

output/sections/*
!output/sections/.gitkeep

output/quality_checks/*
!output/quality_checks/.gitkeep

output/profiles/*
!output/profiles/.gitkeep

# Evaluation outputs are safe to push if they contain only aggregate/anonymized metrics
!output/evaluation/
!output/evaluation/.gitkeep
!output/evaluation/*.csv
!output/evaluation/*.md

# Old generated real-resume outputs
output/real_canonical_candidate_profiles.csv
output/real_canonical_candidate_profiles.json
output/real_resume_line_predictions.csv
 
 